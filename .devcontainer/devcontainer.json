{
  // Network Doodles lab environment · Wireshark 101.
  // Everything runs inside this one container: its own Docker engine (the switch, the routers, the
  // hosts and the browser Wireshark live in there), containerlab, and a browser IDE.
  //
  //   Codespaces  the badge in the README: nothing to install
  //   VS Code     "Dev Containers: Reopen in Container"
  //   Browser     devcontainer up, then http://localhost:13337 (code-server)
  "name": "Network Doodles · Wireshark 101",
  "build": { "dockerfile": "Dockerfile", "context": ".." },
  "privileged": true,
  "remoteUser": "vscode",
  "hostRequirements": { "cpus": 2, "memory": "4gb" },

  "features": {
    "ghcr.io/coder/devcontainer-features/code-server:2": {
      "host": "0.0.0.0",
      "port": "13337",
      "auth": "none",
      "workspace": "/workspaces/${localWorkspaceFolderBasename}",
      "disableTelemetry": true,
      "disableUpdateCheck": true,
      "extensions": "srl-labs.vscode-containerlab,redhat.vscode-yaml"
    }
  },

  // code-server and the Wireshark page have no password, so they are only ever published on this machine's loopback.
  "appPort": ["127.0.0.1:13337:13337", "127.0.0.1:3000:3000"],
  // 3000: Wireshark in the browser (make wireshark). Codespaces serves it over HTTPS and keeps it private
  // (only you, signed in to GitHub, can open it): keep it that way, the Wireshark page has no login of its own.
  "forwardPorts": [13337, 3000],
  "portsAttributes": {
    "13337": { "label": "code-server (browser IDE)", "onAutoForward": "silent" },
    "3000": { "label": "Wireshark", "onAutoForward": "notify", "protocol": "http" }
  },

  // Once, when the container is created: the images, inside this container's own Docker.
  "postCreateCommand": "make setup images",
  // Every start: the network.
  "postStartCommand": "make up",

  "customizations": {
    "vscode": {
      "extensions": ["srl-labs.vscode-containerlab", "redhat.vscode-yaml"],
      "settings": {
        "task.allowAutomaticTasks": "on",
        "python.defaultInterpreterPath": "/home/vscode/.venvs/lab/bin/python",
        "python.useEnvironmentsExtension": false,
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
